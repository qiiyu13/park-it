[Unit]
Description=E-Parking Gate-In Daemon for Gate %i
Requires=redis-server.service
After=network.target redis-server.service

[Service]
Type=simple
User=parking
Group=parking
SupplementaryGroups=dialout
WorkingDirectory=/opt/parking-system-v2
Environment=APP_ENV=production
Environment=PATH=/opt/parking-system-v2/.venv/bin
EnvironmentFile=/opt/parking-system-v2/.env
ExecStart=/opt/parking-system-v2/.venv/bin/python -m daemons.cli --gate-id %i
Restart=always
# Fast recovery: every second of daemon downtime is a blocked lane.
RestartSec=2
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parking-daemon-gate-in-%i

[Install]
WantedBy=multi-user.target
