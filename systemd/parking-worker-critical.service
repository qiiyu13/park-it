[Unit]
Description=E-Parking Critical Worker (ARQ)
# Ubuntu's Redis unit is redis-server.service (redis.service does not exist).
After=network.target redis-server.service postgresql.service
Wants=redis-server.service postgresql.service

[Service]
Type=simple
User=parking
Group=parking
WorkingDirectory=/opt/parking-system-v2
Environment=APP_ENV=production
Environment=PATH=/opt/parking-system-v2/.venv/bin
EnvironmentFile=/opt/parking-system-v2/.env
ExecStart=/opt/parking-system-v2/.venv/bin/arq workers.settings.CriticalWorkerSettings
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parking-worker-critical

[Install]
WantedBy=multi-user.target
