[Unit]
Description=E-Parking Database Backup
After=postgresql.service

[Service]
Type=oneshot
User=parking
# systemd creates /var/lib/parking-backups owned by User= — without this the
# script's `mkdir -p /var/backups/parking` fails on a fresh install and the
# nightly backup never runs.
StateDirectory=parking-backups
Environment=BACKUP_DIR=/var/lib/parking-backups
ExecStart=/opt/parking-system-v2/scripts/backup_database.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=parking-backup
