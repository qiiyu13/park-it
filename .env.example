# =============================================================================
# Application
# =============================================================================
APP_NAME=E-Parking v2
APP_ENV=development
DEBUG=true
# Facility timezone — drives shift windows and the midnight overnight surcharge.
APP_TIMEZONE=Asia/Jakarta

# =============================================================================
# Database (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=parking
DB_USER=parking
DB_PASSWORD=parking_secret
# Sized against Postgres max_connections=100 across all processes
# (4 gunicorn + events + 2 ARQ workers). 20+10 each could demand 120+.
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=4

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# =============================================================================
# Authentication (JWT)
# =============================================================================
JWT_SECRET=change-me-in-production-use-a-64-char-random-string-here-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Security
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# Notifications
# =============================================================================
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Chat/group ID that receives operational alerts (gate down, settlement failed).
TELEGRAM_CHAT_ID=

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# Internal API key for booth bridge / machine-to-machine auth
# =============================================================================
INTERNAL_API_KEY=change-me-in-production

# =============================================================================
# E-money settlement (SFTP). Leave SETTLEMENT_SFTP_HOST empty to disable the
# settlement uploader; uploads are skipped, never retried forever.
# SETTLEMENT_SFTP_KNOWN_HOSTS is mandatory when the host is set — in
# production an empty value disables host-key verification (MITM risk).
# =============================================================================
SETTLEMENT_SFTP_HOST=
SETTLEMENT_SFTP_PORT=22
SETTLEMENT_SFTP_USERNAME=
SETTLEMENT_SFTP_KEY_PATH=
SETTLEMENT_SFTP_KNOWN_HOSTS=
SETTLEMENT_SFTP_REMOTE_DIR=/incoming
SETTLEMENT_SFTP_RESPONSE_DIR=/incoming
SETTLEMENT_SFTP_CONNECT_TIMEOUT=30

PRINTER_PAPER_COUNTER_ENABLED=false
PRINTER_PAPER_WARNING_THRESHOLD=50
PRINTER_PAPER_CRITICAL_THRESHOLD=10
