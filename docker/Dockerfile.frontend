# syntax=docker/dockerfile:1
FROM node:22-alpine AS build

WORKDIR /app

# Install dependencies
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy source and build
COPY frontend/ .
ENV NUXT_PUBLIC_API_BASE_URL=""
ENV NUXT_PUBLIC_WS_BASE_URL=""
ENV NUXT_PUBLIC_BOOTH_BRIDGE_URL=""
RUN npm run build

# Production: serve static via nginx
FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
# nginx `root` is /var/www/parking-frontend and try_files resolves /index.html
# against it — the build output must land THERE, not in a .output subdirectory
# (which made every SPA deep link 404/redirect-loop).
COPY --from=build /app/.output/public /var/www/parking-frontend

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
